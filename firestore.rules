rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── SUPER ADMIN UTILITIES ───
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'anshu@admin.com' ||
        request.auth.token.email == 'rishabhsonawane18@gmail.com' ||
        request.auth.token.email == 'sonawaneanshu18@gmail.com'
      );
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ─── GLOBAL SETTINGS ───
    match /GlobalSettings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin(); // Locked down for production
    }

    // ─── GLOBAL TICKETS (Complaints to Super Admin) ───
    match /GlobalTickets/{ticketId} {
      allow create: if request.auth != null; // Any logged-in user (gym owner) can create
      allow read, update, delete: if isSuperAdmin();
      // Allow gym owner to read their own tickets
      allow read: if request.auth != null && resource.data.gymId == request.auth.uid;
    }

    // ─── GYM DOCUMENT ───
    // Anyone can read gym info (needed for member portal search).
    // Only the authenticated gym owner can write to their own gym document, OR Super Admin.
    match /Gyms/{gymId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == gymId;
      allow write: if isSuperAdmin();

      // ─── MEMBERS ───
      // Members are readable by anyone (member portal self-service).
      // Only the gym owner can create or delete members.
      // Updates are allowed by the gym owner OR by staff (any signed-in user)
      // — limited to non-sensitive fields only (e.g. attendance password).
      match /Members/{memberId} {
        allow read: if true;
        allow delete: if request.auth != null && request.auth.uid == gymId;
        allow create: if request.auth != null && request.auth.uid == gymId && 
                      (get(/databases/$(database)/documents/Gyms/$(gymId)).data.status != 'trial' || 
                       get(/databases/$(database)/documents/Gyms/$(gymId)).data.activeMembersCount < 5 ||
                       !("activeMembersCount" in get(/databases/$(database)/documents/Gyms/$(gymId)).data));
        // Gym owners can update everything.
        // Members (unauthenticated) can ONLY update their password and phone during onboarding.
        allow update: if (request.auth != null && request.auth.uid == gymId) ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'phone']));

        // Assessments: members can create their own, owner can edit/delete
        match /Assessments/{assessmentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.uid == gymId;
        }
      }

      // ─── ATTENDANCE ───
      // Anyone can mark attendance (first check-in) or update check-out time via the check-in page.
      // Only the owner can delete attendance records.
      match /Attendance/{date}/Records/{recordId} {
        allow read, create, update: if true;
        allow delete: if request.auth != null && request.auth.uid == gymId;
      }

      // ─── QUERIES / COMPLAINTS ───
      // Anyone (including unauthenticated members) can submit a complaint.
      // Only the gym owner can read, update, and delete queries.
      match /Queries/{queryId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == gymId;
      }

      // ─── EXPENSES, TICKETS, TRANSACTIONS, AUDIT LOGS ───
      // Strictly owner-only. No public or staff access.
      match /Expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == gymId;
      }
      match /Tickets/{ticketId} {
        allow read, write: if request.auth != null && request.auth.uid == gymId;
      }
      match /Transactions/{txnId} {
        allow read, write: if request.auth != null && request.auth.uid == gymId;
      }
      match /AuditLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == gymId;
      }

      // ─── EVERYTHING ELSE (Enquiries, Staff, Timeline, etc.) ───
      // Full access only for the authenticated gym owner.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == gymId;
      }
    }
  }
}
